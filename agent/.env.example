# Copiá este archivo como `agent/.env` y completá GOOGLE_API_KEY.
#   cp agent/.env.example agent/.env

# --- Modelo de lenguaje ---
# API key de Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=tu_api_key_aca

# Nombre del modelo. Sin "/" se usa el proveedor nativo de ADK (Gemini).
# Con "/" se enruta por LiteLLM, por ejemplo:
#   MODEL_NAME=ollama_chat/minimax-m2.1:cloud
MODEL_NAME=gemini-3.5-flash-lite

# --- Base vectorial (RAG) ---
# Directorio donde Chroma persiste los datos. Relativo al directorio de ejecución.
CHROMA_DIR=./vector_store

# Colección que se usa cuando el usuario no especifica una.
DEFAULT_COLLECTION=reconocimiento

# --- Embeddings (Ollama) ---
# Requiere: ollama serve  +  ollama pull nomic-embed-text
OLLAMA_API_BASE=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# --- Límites de las herramientas de red ---
NMAP_TIMEOUT=120
HTTP_TIMEOUT=8
TCP_TIMEOUT=3
